---
import { testimonials } from '../data/siteData';
---
<!-- =========================================================================
     SECTION 7: TESTIMONI & ULASAN KLIEN (Social Proof + Video Snippet)
     ========================================================================= -->
<section id="testimoni" class="py-20 bg-nusa-navy text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-nusa-gold">Testimoni & Social Proof</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mt-2">
        Cerita dari Mereka yang Sudah Buktikan Sendiri
      </h2>
      <p class="text-slate-300 text-sm sm:text-base mt-2">
        Kepercayaan Anda adalah prioritas kami. Berikut adalah pengalaman nyata dari panitia sekolah, instansi, dan keluarga yang telah berangkat bersama NUSA Tour & Travel.
      </p>
    </div>

    <!-- 3 Testimonial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <div class={`${t.cardClass} p-7 rounded-2xl flex flex-col justify-between`}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex text-nusa-gold text-sm gap-1">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <span class={`text-[11px] px-2.5 py-0.5 rounded-full ${t.badgeClass} font-semibold`}>{t.category}</span>
            </div>
            <p class={`${t.textClass} text-sm leading-relaxed italic mb-6`}>
              {t.quote}
            </p>
          </div>
          <div class="flex items-center gap-3.5 pt-4 border-t border-white/10">
            <div class={`w-11 h-11 rounded-full ${t.avatarClass} font-extrabold flex items-center justify-center text-sm`}>
              {t.initials}
            </div>
            <div>
              <h4 class="font-bold text-white text-sm">{t.author}</h4>
              <p class={`text-xs ${t.roleClass}`}>{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
