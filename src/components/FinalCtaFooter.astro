     ========================================================================= -->
<section class="py-16 bg-gradient-to-b from-nusa-navy to-nusa-dark text-white border-t border-white/10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="bg-nusa-elevated/90 border border-nusa-gold/30 rounded-3xl p-8 sm:p-12 shadow-2xl">
