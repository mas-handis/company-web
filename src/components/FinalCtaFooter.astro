          <span>Hubungi Tim NUSA Sekarang</span>
        </button>
        <button onclick="openBrochureModal()" class="w-full sm:w-auto bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold px-7 py-4 rounded-2xl transition flex items-center justify-center gap-2 text-base">
          <i class="fa-solid fa-file-arrow-down text-nusa-gold"></i>
          <span>Minta Proposal Resmi (PDF)</span>
        </button>
      </div>
    </div>
  </div>
</section>

