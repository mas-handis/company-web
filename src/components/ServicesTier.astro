<!-- =========================================================================
     OVERLAPPING 3-COLUMN TIER (Directly Inspired by Reference Image Structure)
     Left: Legalitas & About | Center (Elevated): 4 Keunggulan/Layanan | Right: Recent Trips
     ========================================================================= -->
<section id="layanan" class="relative z-20 bg-nusa-dark pb-20 pt-4 lg:pt-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:-mt-24 items-stretch">
      
      <!-- LEFT CARD: Tentang Kami & Legalitas NIB -->
      <div class="lg:col-span-4 bg-nusa-navy rounded-2xl p-7 sm:p-8 glass-border shadow-xl flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-sky-400">Tentang & Legalitas</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-4">Biro Perjalanan Resmi</h2>
          <p class="text-slate-300 text-sm leading-relaxed mb-5">
            Perjalanan aman dan tenang bersama biro perjalanan resmi berbadan hukum. Kami mengeliminasi risiko travel bodong dengan legalitas pemerintah yang transparan.
          </p>
          
          <!-- NIB Legal Badge Box -->
          <div class="bg-nusa-dark/90 border border-nusa-gold/40 rounded-xl p-4 mb-6">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-nusa-gold/20 border border-nusa-gold text-nusa-gold flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-solid fa-shield-halved text-lg"></i>
              </div>
              <div>
                <span class="text-[11px] uppercase tracking-wider text-nusa-gold font-bold block">Terdaftar Resmi OSS RBA</span>
                <h3 class="text-white font-bold text-sm">PT Nusa Tour & Travel Indonesia</h3>
                <p class="text-slate-300 text-xs font-mono mt-1">NIB: 2010260083763</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Preview Image Bottom (Like Reference Left Card) -->
        <div class="relative rounded-xl overflow-hidden h-44 group">
          <img src="https://images.unsplash.com/photo-1525625293386-3f8f99389edd?auto=format&fit=crop&w=800&q=80" 
               alt="Marina Bay Sands Singapore" 
               class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
               data-fallback-src="https://placehold.co/600x400/061226/FFFFFF?text=Singapore+Trip">
          <div class="absolute inset-0 bg-gradient-to-t from-nusa-dark via-nusa-dark/30 to-transparent flex items-end p-4">
            <div class="flex items-center justify-between w-full text-xs text-white">
              <span class="font-semibold"><i class="fa-solid fa-location-dot text-nusa-gold mr-1"></i> Operasional KL & Batam/ID</span>
              <span class="px-2 py-0.5 bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 rounded">Verified</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CENTER CARD (ELEVATED): Layanan & Keunggulan Kami (2x2 Grid like "Our Expertise" in Reference) -->
      <div class="lg:col-span-4 bg-nusa-elevated rounded-2xl p-7 sm:p-9 border border-sky-400/30 shadow-elevated lg:-mt-6 lg:-mb-4 flex flex-col justify-between relative overflow-hidden">
        <!-- Subtle Top Highlight Bar -->
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-nusa-blue via-nusa-gold to-nusa-blue"></div>

        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-nusa-gold">Layanan Utama Kami</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-6">Solusi Perjalanan Anda</h2>

          <!-- 2x2 Grid matching reference "Our Expertise" -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Item 1: Safari Edukasi -->
            <div class="border-b border-white/10 pb-5 sm:border-r sm:pr-4">
              <div class="w-10 h-10 rounded-lg bg-sky-500/15 text-sky-400 flex items-center justify-center mb-3">
                <i class="fa-solid fa-graduation-cap text-xl"></i>
              </div>
              <h3 class="text-white font-bold text-base mb-1.5">Safari Edukasi & PKL</h3>
              <p class="text-slate-300 text-xs leading-relaxed">
                Kunjungan industri, <em>study tour</em> sekolah/kampus, & PKL Internasional berjadwal rapi.
              </p>
            </div>

            <!-- Item 2: Corporate Gathering -->
            <div class="border-b border-white/10 pb-5 sm:pl-2">
              <div class="w-10 h-10 rounded-lg bg-nusa-gold/15 text-nusa-gold flex items-center justify-center mb-3">
                <i class="fa-solid fa-briefcase text-xl"></i>
              </div>
              <h3 class="text-white font-bold text-base mb-1.5">Corporate Gathering</h3>
              <p class="text-slate-300 text-xs leading-relaxed">
                Perkuat solidaritas tim tanpa pusing logistik tiket, hotel, bus, hingga <em>team building</em>.
              </p>
            </div>

            <!-- Item 3: Private Trip 3 Negara -->
            <div class="pt-1 sm:border-r border-white/10 sm:pr-4">
              <div class="w-10 h-10 rounded-lg bg-emerald-500/15 text-emerald-400 flex items-center justify-center mb-3">
                <i class="fa-solid fa-plane-departure text-xl"></i>
              </div>
              <h3 class="text-white font-bold text-base mb-1.5">Private Trip 3 Negara</h3>
              <p class="text-slate-300 text-xs leading-relaxed">
                Liburan keluarga eksklusif ke Malaysia, Singapura & Thailand dengan rute fleksibel.
              </p>
            </div>

            <!-- Item 4: Custom & Land Arrangement -->
            <div class="pt-1 sm:pl-2">
              <div class="w-10 h-10 rounded-lg bg-purple-500/15 text-purple-300 flex items-center justify-center mb-3">
                <i class="fa-solid fa-route text-xl"></i>
              </div>
              <h3 class="text-white font-bold text-base mb-1.5">Custom Itinerary VIP</h3>
              <p class="text-slate-300 text-xs leading-relaxed">
                Bebas rombak jadwal, pilihan kuliner halal, & hotel bintang 3/4/5 sesuai anggaran.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-7 pt-4 border-t border-white/10">
          <button onclick="triggerWA('Card Layanan Tengah - Konsultasi Kebutuhan')" class="w-full py-3 px-4 rounded-xl bg-nusa-gold hover:bg-amber-400 text-nusa-dark font-bold text-xs uppercase tracking-wider transition flex items-center justify-center gap-2 shadow-lg">
            <span>Rancang Itinerary Rombongan</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>

      <!-- RIGHT CARD: Jejak Keberangkatan Terbaru (Matching "Recent Projects" in Reference) -->
      <div class="lg:col-span-4 bg-nusa-navy rounded-2xl p-7 sm:p-8 glass-border shadow-xl flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-sky-400">Portofolio Terkini</span>
          <h2 class="text-2xl font-bold text-white mt-1 mb-5">Jejak Keberangkatan</h2>

          <div class="space-y-4">
            <!-- Project Card 1 -->
            <div class="group rounded-xl overflow-hidden bg-nusa-dark border border-white/10">
              <div class="relative h-32 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=700&q=80" 
                     alt="Safari Edukasi MTsN 1 Kota Bima" 
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                     data-fallback-src="https://placehold.co/600x300/112A52/FFFFFF?text=Safari+Edukasi+Malaysia">
                <span class="absolute top-2.5 right-2.5 bg-nusa-gold text-nusa-dark text-[10px] font-extrabold px-2.5 py-0.5 rounded-full">
                  Edukasi & Sekolah
                </span>
              </div>
              <div class="p-3.5">
                <h3 class="text-white font-bold text-sm">Safari Edukasi & Studi Banding – MTsN 1 Kota Bima</h3>
                <p class="text-slate-400 text-xs mt-0.5">Kuala Lumpur & Putrajaya, Malaysia</p>
              </div>
            </div>

            <!-- Project Card 2 -->
            <div class="group rounded-xl overflow-hidden bg-nusa-dark border border-white/10">
              <div class="relative h-32 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1563492065599-3520f775eeed?auto=format&fit=crop&w=700&q=80" 
                     alt="PKL Internasional & Tour 3 Negara" 
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                     data-fallback-src="https://placehold.co/600x300/112A52/FFFFFF?text=Tour+3+Negara">
                <span class="absolute top-2.5 right-2.5 bg-sky-400 text-nusa-dark text-[10px] font-extrabold px-2.5 py-0.5 rounded-full">
                  3 Negara
                </span>
              </div>
              <div class="p-3.5">
                <h3 class="text-white font-bold text-sm">PKL Internasional & Eksplorasi 3 Negara</h3>
                <p class="text-slate-400 text-xs mt-0.5">Malaysia • Singapura • Hat Yai Thailand</p>
              </div>
            </div>
          </div>
        </div>

        <a href="#galeri" class="mt-4 inline-flex items-center justify-center gap-2 text-xs font-semibold text-sky-400 hover:text-nusa-gold transition pt-2">
          <span>Lihat Semua Dokumentasi Rombongan</span>
          <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </a>
      </div>

    </div>
  </div>
</section>
