---
import { packages } from '../data/siteData';
---
<!-- =========================================================================
     SECTION 5: DESTINASI & PAKET POPULER (3-4 Card Paket Unggulan)
     ========================================================================= -->
<section id="paket" class="py-20 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header + Filter Tabs -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-nusa-blue">Katalog Program Terlaris</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-nusa-dark mt-2">
          Destinasi & Paket Populer
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl">
          Pilih program unggulan kami atau sesuaikan durasi dan destinasi sesuai kebutuhan peserta Anda.
        </p>
      </div>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap gap-2">
        <button onclick="filterPackages('all')" id="tab-all" class="pkg-tab bg-nusa-navy text-white px-4 py-2 rounded-lg text-xs font-bold transition">Semua Paket</button>
        <button onclick="filterPackages('edukasi')" id="tab-edukasi" class="pkg-tab bg-white text-slate-700 hover:bg-slate-200 px-4 py-2 rounded-lg text-xs font-bold transition">Edukasi & PKL</button>
        <button onclick="filterPackages('tiganegara')" id="tab-tiganegara" class="pkg-tab bg-white text-slate-700 hover:bg-slate-200 px-4 py-2 rounded-lg text-xs font-bold transition">3 Negara</button>
        <button onclick="filterPackages('private')" id="tab-private" class="pkg-tab bg-white text-slate-700 hover:bg-slate-200 px-4 py-2 rounded-lg text-xs font-bold transition">Corporate / Private</button>
      </div>
    </div>

    <!-- 4 Package Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {packages.map((pkg) => (
        <div data-category={pkg.category} class="pkg-card bg-white rounded-2xl overflow-hidden shadow-card border border-slate-200/80 flex flex-col justify-between hover:-translate-y-1 transition duration-300">
          <div>
            <div class="relative h-48 overflow-hidden">
              <img src={pkg.image} alt={pkg.imageAlt} class="w-full h-full object-cover" loading="lazy" />
              <span class={`absolute top-3 left-3 ${pkg.badgeClass} text-[11px] font-bold px-3 py-1 rounded-full`}>
                {pkg.badgeText}
              </span>
              <span class="absolute bottom-3 right-3 bg-white/95 text-nusa-dark text-xs font-extrabold px-2.5 py-1 rounded-md shadow">
                {pkg.duration}
              </span>
            </div>
            <div class="p-5">
              <div class="text-xs font-semibold text-nusa-blue mb-1">{pkg.countries}</div>
              <h3 class="font-bold text-lg text-nusa-dark leading-snug mb-3">
                {pkg.title}
              </h3>
              <ul class="space-y-2 text-xs text-slate-600 mb-5">
                {pkg.features.map((feat) => (
                  <li class="flex items-center gap-2">
                    <i class="fa-solid fa-check text-emerald-500"></i> {feat}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="p-5 pt-0">
            <button onclick={`triggerWA('${pkg.waContext}')`} class="w-full bg-nusa-navy hover:bg-nusa-blue text-white font-bold py-3 rounded-xl text-xs transition flex items-center justify-center gap-2">
              <i class="fa-regular fa-file-lines"></i>
              <span>Minta Detail Itinerary</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
